# AgentVault environment variable template
#
# Copy this file to .env and fill in local values.
# .env is gitignored and must NEVER be committed.
# NEVER paste a private key that controls real funds anywhere.

# ---- Local development chain (Anvil) ----
# Anvil prints well-known test keys on startup. Those keys are public,
# known to everyone, and worthless. Use them ONLY on a local chain.
LOCAL_RPC_URL=http://127.0.0.1:8545

# ---- Robinhood Chain testnet ----
# Verify chain ID yourself before trusting it. See docs/ASSUMPTIONS.md U1.
RH_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
RH_TESTNET_CHAIN_ID=46630

# ---- Robinhood Chain mainnet ----
# Present for documentation only. Do NOT use before audit and legal review.
RH_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RH_MAINNET_CHAIN_ID=4663

# ---- Deployer ----
# Leave empty here. Populate only in your local .env, never in this file.
DEPLOYER_PRIVATE_KEY=
